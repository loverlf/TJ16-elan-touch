name: Build VoodooELAN

on:
  workflow_dispatch:
  push:

jobs:
  build:
    runs-on: macos-15
    steps:
      - uses: actions/checkout@v4

      - name: Build kext
        run: |
          perl -pi -e 's/\r$//' build.sh
          chmod +x build.sh
          ./build.sh

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: VoodooELAN-kext
          path: build/VoodooELAN.kext
